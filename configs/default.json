{
  "schemaVersion": 1,
  "name": "住院患者医嘱取证",
  "variables": {
    "hospitalization_number": "ZY26"
  },
  "settings": {
    "outputDir": "output"
  },
  "steps": [
    {
      "id": "step-mtkyirov-op8pn",
      "type": "window.activate",
      "name": "连接窗口",
      "enabled": true,
      "params": {
        "windowTitle": "医院信息系统（HIS）"
      }
    },
    {
      "id": "step-mtkzmcf2-9kd29",
      "type": "visual.input_field",
      "name": "填写科室名",
      "enabled": true,
      "params": {
        "fieldName": "科室",
        "value": "消化内科",
        "pressEnter": true,
        "timeoutSeconds": 5
      },
      "templateId": "module-8ec5bbe6046d"
    },
    {
      "id": "step-mtkzms31-60mf3",
      "type": "utility.wait",
      "name": "等待查询结果",
      "enabled": true,
      "params": {
        "seconds": 1
      }
    },
    {
      "id": "step-mtkzmsvz-7jlv4",
      "type": "visual.click_table_row",
      "name": "点击表格第一行",
      "enabled": true,
      "params": {
        "tableTitle": "患者查询",
        "headerText": "序号",
        "row": 1,
        "clickColumn": "序号",
        "visualPage": "current-page"
      }
    },
    {
      "id": "step-mtkzmtqj-8ke5x",
      "type": "utility.wait",
      "name": "等待页面加载",
      "enabled": true,
      "params": {
        "seconds": 1
      }
    },
    {
      "id": "step-mtkzmvfs-jkg33",
      "type": "capture.current",
      "name": "截取当前位置",
      "enabled": true,
      "params": {
        "filePrefix": "table_${hospitalization_number}"
      }
    },
    {
      "id": "step-mtkzmvwt-igpx4",
      "type": "capture.rightmost",
      "name": "截取横向最右端",
      "enabled": true,
      "params": {
        "filePrefix": "table_${hospitalization_number}",
        "restorePosition": true,
        "layoutWaitSeconds": 0.5
      }
    },
    {
      "id": "step-mtkzmwfz-ytm80",
      "type": "ocr.mark_columns",
      "name": "OCR 标注表格列",
      "enabled": true,
      "params": {
        "columns": [
          "医嘱名称",
          "单次剂量",
          "剂量单位",
          "频次",
          "总量",
          "总量单位"
        ]
      }
    }
  ]
}
