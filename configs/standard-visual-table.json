{
  "schemaVersion": 1,
  "name": "标准视觉表格取证",
  "variables": {
    "hospitalization_number": "ZY26031245"
  },
  "settings": {
    "outputDir": "output"
  },
  "steps": [
    {
      "id": "standard-01-activate",
      "type": "window.activate",
      "name": "01 连接窗口",
      "enabled": true,
      "params": {
        "windowTitle": "医院信息系统（HIS）"
      }
    },
    {
      "id": "standard-02-maximize",
      "type": "window.maximize",
      "name": "02 最大化窗口",
      "enabled": true,
      "params": {
        "layoutWaitSeconds": 0.6
      }
    },
    {
      "id": "standard-07-current",
      "type": "capture.current",
      "name": "07 截取当前位置",
      "enabled": true,
      "params": {
        "filePrefix": "table_${hospitalization_number}"
      }
    },
    {
      "id": "standard-08-rightmost",
      "type": "capture.rightmost",
      "name": "08 截取横向最右端",
      "enabled": true,
      "params": {
        "filePrefix": "table_${hospitalization_number}",
        "restorePosition": true,
        "layoutWaitSeconds": 0.5
      }
    },
    {
      "id": "standard-09-ocr",
      "type": "ocr.mark_columns",
      "name": "09 OCR 标注审核字段",
      "enabled": true,
      "params": {
        "locateMode": "按表格标题",
        "tableTitle": "医嘱明细",
        "columns": [
          "医嘱名称",
          "单次剂量",
          "剂量单位",
          "频次",
          "总量",
          "总量单位"
        ],
        "screenshotScope": "全部原始截图",
        "headerSearchHeight": 90,
        "tableRightRatio": 0.74
      }
    }
  ]
}
